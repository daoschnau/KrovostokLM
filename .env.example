# Telegram — токен бота у @BotFather
TG_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API — бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# DeepInfra — эмбеддинг запросов (тот же e5-large, что в базе).
# Ключ: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=di_xxxxxxxxxxxxxxxxxxxxxxxx

# Бэкенд эмбеддинга: "api" (DeepInfra, дефолт — для сервера) или
# "local" (sentence-transformers, ~2.5 ГБ — только для пересборки базы/тестов).
# EMBED_BACKEND=api

# Модель Groq для HyDE и реранкинга.
#   llama-3.3-70b-versatile — лучшее качество, но дневной лимит 100k токенов (~100 запросов/день)
#   llama-3.1-8b-instant    — слабее, но ~5x дневной бюджет. Разумный дефолт для ПУБЛИЧНОГО бота.
GROQ_MODEL=llama-3.3-70b-versatile

# (необязательно) выключить HyDE — поиск пойдёт по сырому запросу, останется только реранкинг
# USE_HYDE=false

# (необязательно) cooldown в секундах: после rate-limit бот временно отвечает на сыром e5,
# не дёргая Groq, чтобы не копить латентность под нагрузкой
# GROQ_COOLDOWN_SEC=120

# (необязательно) анти-магнит: сколько последних треков помнить на сессию (chat_id),
# чтобы один трек не липнул ко всем ответам подряд. 0 — выключить.
# GROQ_RECENT_TRACKS=5
