# Groq API — бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Модель Groq для HyDE и реранкинга.
#   llama-3.3-70b-versatile — лучшее качество, но дневной лимит 100k токенов (~100 запросов/день)
#   llama-3.1-8b-instant    — слабее, но ~5x дневной бюджет. Разумный дефолт для ПУБЛИЧНОГО бота.
GROQ_MODEL=llama-3.3-70b-versatile

# (необязательно) выключить HyDE — поиск пойдёт по сырому запросу, останется только реранкинг
# USE_HYDE=false

# (необязательно) cooldown в секундах: после rate-limit бот временно отвечает на сыром e5,
# не дёргая Groq, чтобы не копить латентность под нагрузкой
# GROQ_COOLDOWN_SEC=120
